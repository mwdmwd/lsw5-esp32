# SPDX-License-Identifier: GPL-3.0-or-later

BasedOnStyle: LLVM

# East const for every type, including built-ins (int const, T const &).
QualifierAlignment: Right

# Tabs are indentation, spaces are alignment.
UseTab: ForIndentation
IndentWidth: 4
TabWidth: 4

# Treat braced initializer bodies like block indentation so their leading
# indent can be tabs; the LLVM default treats them as continuation alignment.
Cpp11BracedListStyle: false

BreakBeforeBraces: Allman
BreakBinaryOperations: RespectPrecedence
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
BreakTemplateDeclarations: Yes
IndentCaseLabels: true
AccessModifierOffset: -4
SpaceBeforeParens: Never
SpaceAfterTemplateKeyword: false
FixNamespaceComments: false
SkipMacroDefinitionBody: true
ColumnLimit: 100
